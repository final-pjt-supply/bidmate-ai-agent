{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAgentContainerLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:ap-northeast-2:890608337282:log-group:/bidmate/agent:*"
    },
    {
      "Sid": "DescribeAgentLogGroup",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    }
  ]
}
